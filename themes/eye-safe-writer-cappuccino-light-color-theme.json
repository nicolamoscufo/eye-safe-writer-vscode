  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8c8fa1"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "support.constant"
      ],
      "settings": {
        "foreground": "#fe640b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#df8e1d"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7287fd"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#40a02b"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#4c4f69"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "support.variable.property",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#6c6f85"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#8c8fa1"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "scope": [
        "markup.heading.1.markdown",
        "markup.heading.setext.1.markdown"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#40a02b"
      }
    },
    {
      "scope": "markup.heading.2.markdown",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#1e66f5"
      }
    },
    {
      "scope": "markup.heading.3.markdown",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#d20f39"
      }
    },
    {
      "scope": "markup.heading.4.markdown",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#40a02b"
      }
    },
    {
      "scope": "markup.heading.5.markdown",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#7287fd"
      }
    },
    {
      "scope": "markup.heading.6.markdown",
      "settings": {
        "fontStyle": "bold",
        "foreground": "#fe640b"
      }
    },
    {
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#ea76cb"
      }
    },
    {
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#fe640b"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "meta.link.inline"
      ],
      "settings": {
        "foreground": "#1a56d2"
      }
    },
    {
      "scope": [
        "markup.quote",
        "punctuation.definition.quote.begin.markdown"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#40a02b"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block",
        "markup.raw.block"
      ],
      "settings": {
        "foreground": "#40a02b"
      }
    },
    {
      "scope": [
        "markup.list",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#df8e1d"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#d20f39"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#1e66f5"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#df8e1d",
    "comment": {
      "foreground": "#8c8fa1",
      "italic": true
    },
    "decorator": "#ea76cb",
    "enum": "#df8e1d",
    "function": "#1e66f5",
    "interface": "#1e66f5",
    "keyword": "#7287fd",
    "method": "#1e66f5",
    "namespace": "#7287fd",
    "number": "#fe640b",
    "operator": "#8c8fa1",
    "property": "#6c6f85",
    "regexp": "#df8e1d",
    "string": "#40a02b",
    "struct": "#df8e1d",
    "type": "#df8e1d",
    "variable": "#4c4f69"
  }
