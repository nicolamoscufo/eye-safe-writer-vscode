    "keyword": "#b48ead",
    "method": "#81a1c1",
    "namespace": "#b48ead",
    "number": "#d08770",
    "operator": "#8792a2",
    "property": "#d8dee9",
    "regexp": "#ebcb8b",
    "string": "#a3be8c",
    "struct": "#ebcb8b",
    "type": "#ebcb8b",
    "variable": "#eceff4"
  }
